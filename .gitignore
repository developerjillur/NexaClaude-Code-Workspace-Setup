# macOS AppleDouble files — this drive is exFAT, so they appear on every write
._*
.DS_Store

# generated
graphify-out/
node_modules/

# links to the other trees (see SETUP.md)
code
plan

# Every prompt, saved by scripts/hooks/save-prompt.mjs.
#
# Ignored on purpose. Secrets are scrubbed on write, but that is mitigation and a novel
# format will get through — prompts in this project have already carried a VPS root password
# and an OAuth code. Not committing is the first line of defence; the scrubber is the second.
#
# To keep a day deliberately: read it, then `git add -f docs/prompts/YYYY-MM-DD.md`.
docs/prompts/

# generated by scripts/hooks/pre-compact.mjs — working-tree snapshots, not a record to review
docs/compactions/

# per-prompt check state — a remembered count, not a record
docs/.prompt-check-state.json

# The council is fetched from GitHub at setup, never vendored — see
# scripts/council-sync.mjs for why a copy is a dependency with a timer on it.
.council-src
/scripts/council
/tests/council.test.mjs
/tests/survives-session-death.mjs
/commands
/.agents/skills/council
/.claude/commands/council.md
/.claude/commands/council-custom.md
/.council-version
